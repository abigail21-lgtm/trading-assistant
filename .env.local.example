# Optional. Without these set, the app runs in local mode (no login,
# watchlist saved in the browser) -- see README. To turn on real accounts,
# create a free project at https://supabase.com and copy these from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
