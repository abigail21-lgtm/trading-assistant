# Optional. Without these set, the app runs in local mode (no login,
# watchlist saved in the browser) -- see README. To turn on real accounts,
# create a free project at https://supabase.com and copy these from
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, and only needed for true push notifications (see README).
# Server-only -- from Project Settings -> API -> service_role secret. Never
# expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional, and only needed for true push notifications. Generate with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
